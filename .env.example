# Copy this file to .env to configure optional LLM tool-calling mode.
# Create an API key at https://platform.openai.com/api-keys.
# Shell environment variables take precedence over values from .env.
# Omit the key to use local TF-IDF search and deterministic research summaries.
OPENAI_API_KEY=
# Set this to a model available to your OpenAI API project.
OPENAI_MODEL=gpt-6-luna
# Optional OpenAI-compatible endpoint. Defaults to https://api.openai.com/v1
OPENAI_BASE_URL=
# Set to 1 to enable the LLM path by default in scripts. The app also has a toggle.
CLAIMS_AGENT_LLM=0


